# These are placeholders. Never commit actual values.
MAX_BOT_TOKEN=SET_IN_LOCKBOX_OR_CONTAINER
MAX_CHANNEL_ID=SET_YOUR_CHANNEL_ID
REQUIRE_CHANNEL_SUBSCRIPTION=1
SESSION_SECRET=GENERATE_RANDOM_64_PLUS_CHARACTERS
MAX_PAYMENT_ADMIN_IDS=SET_YOUR_ADMIN_MAX_ID
FRONTEND_ORIGIN=https://YOUR-NEW-WEB-BUCKET.website.yandexcloud.net
YDB_ENDPOINT=grpcs://YOUR-YDB-ENDPOINT:2135
YDB_DATABASE=/ru-central1/YOUR-DATABASE-PATH
YDB_METADATA_CREDENTIALS=1
# Grant the container service account YDB access. Do not put service-account JSON in Git.
IMAGE_BUCKET=YOUR-NEW-PRIVATE-IMAGE-BUCKET
IMAGE_PREFIX=generator/v1
# Mount via Lockbox; required for S3 boto3 client:
AWS_ACCESS_KEY_ID=YOUR_OBJECT_STORAGE_STATIC_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_OBJECT_STORAGE_STATIC_SECRET
PROXY_API_KEY=YOUR_EXISTING_PROXYAPI_XAI_KEY
REAPI_API_KEY=YOUR_REAPI_KEY
# During private comparison set 1; later switch to 0 without modifying frontend.
PROVIDER_SELECTOR_VISIBLE=1
PROVIDER_DEFAULT=proxyapi
# Never automatically send an unknown request to a second provider.
REAPI_MAX_POLL_SECONDS=95
IMAGE_PRICE_KOPEKS=1000
WELCOME_BONUS_ENABLED=1
GENERATION_ENABLED=0
PAYMENTS_ENABLED=0
PAYMENT_QR_URL=https://storage.yandexcloud.net/YOUR-WEB-BUCKET/payment/QR-SBP.jpg
PAYMENT_SBP_LINK=https://vtb.paymo.ru/collect-money/qr/?transaction=CHECK-YOUR-VTB-LINK
